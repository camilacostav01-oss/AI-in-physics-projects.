C ************************************************************
C MACROBODY DEFINITIONS
C ************************************************************
C Tissue: 200 microns thick, radius 4.9 cm (inside plexiglass)
C z = -0.01 to +0.01
1 RCC 0 0 -0.01 0 0 0.02 4.9       $ Tissue layer
C Culture medium boundary: 1 cm thick, radius 4.9 cm
C z = -0.5 to +0.5
2 RCC 0 0 -0.5  0 0 1.0  4.9       $ Culture medium outer
C Inner air volume: fills to plexiglass inner wall, 3 cm height
C z = -1.5 to +1.5, r = 4.9 cm
3 RCC 0 0 -1.5  0 0 3.0  4.9       $ Inner air/culture volume
C Plexiglass shell: outer boundary, 5 cm radius, 3 cm height
C 1mm thick (5.0 - 4.9 = 0.1 cm)
C z = -1.5 to +1.5, r = 5.0 cm
4 RCC 0 0 -1.5  0 0 3.0  5.0       $ Plexiglass outer
C Polyethylene 1: top cylinder, 30 cm height, 15 cm radius
C z = 1.5 to 31.5
5 RCC 0 0 1.5   0 0 30.0 15.0      $ Polyethylene 1 (top)
C Polyethylene 2: bottom cylinder, 30 cm height, 15 cm radius
C z = -31.5 to -1.5
6 RCC 0 0 -31.5 0 0 30.0 15.0      $ Polyethylene 2 (bottom)
C Large cylinder for air gap around connector: 15 cm radius, 3 cm height
C z = -1.5 to +1.5
10 RCC 0 0 -1.5 0 0 3.0  15.0      $ Large cylinder at center region
C Air box: 70x70 cm base, height covering -31.6 to +31.6
C Slightly taller than poly cylinders to contain them
7 RPP -35.0 35.0 -35.0 35.0 -31.6 31.6   $ Air box
C Lead box: 110x110x103 cm (20 cm thick walls on all sides)
C x,y: -55 to +55 (70 + 2*20 = 110)
C z: -51.5 to +51.5 (31.5 + 20 = 51.5)
8 RPP -55.0 55.0 -55.0 55.0 -51.5 51.5   $ Lead shielding


